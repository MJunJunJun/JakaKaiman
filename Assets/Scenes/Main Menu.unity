--- !u!114 &1789291550
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1789291548}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Jaka Kaimana adalah game edukatif yang terinspirasi dari kisah sejarah
    dan legenda Jaka Kaimana.\r\nDalam permainan ini, pemain mengikuti perjalanan
    Jaka Kaimana untuk menyelesaikan berbagai\r\ntantangan dan misi.\r\n\r\nGame
    ini bertujuan untuk mengenalkan sejarah, budaya, serta nilai-nilai kearifan lokal
    kepada\r\npemain melalui pengalaman bermain yang interaktif dan menyenangkan.\r\n\r\nCerita
    dalam game ini terinspirasi dari kisah yang tertulis dalam Serat Wiraatmaja\r\ndan
    dikembangkan melalui konsultasi bersama Ki Bima Setyo Aji\r\nsebagai narasumber
    budaya.\r\n\n\r\n<size=115%><b>TIM PENGEMBANG:</b></size>\r\n\n<b>Penerima Manfaat
    Dana Indonesiana</b>\r\nMuhammad Junaedi\r\n\r\n<b>Project Manager</b>\r\nUrip
    Brillian Zahni Hibatillah\r\n\r\n<b>Unity Programmer</b>\r\nDio Saputra\r\n\r\n<b>2D
    Animator</b>\r\nMuhammad Gilang Kumbara\r\n\r\n<b>2D Ilustrator</b>\r\nMayaza
    Rahma Sriyatno\r\n\r\n<b>UI / UX Designer</b>\r\nFaiza Rachma\r\n\r\n<b>Script
    Writer</b>\r\nSuci Nur Afifah\r\n\r\n<b>Voice Over</b>\r\nNabila Na\r\nRisky
    M Wijaya\r\n\r\n<b>Game Tester</b>\r\nHanif Reyhan Zahfran A.\r\n\r\n<size=115%><b>UCAPAN
    TERIMA KASIH</b></size>\r\n\r\nAllah SWT\r\nDana Indonesiana \u2013 Kementerian
    Kebudayaan\r\nLPDP\r\nKi Bima Setyo Aji\r\nSanggar Candrabirawa\r\nSemua pihak
    yang telah mendukung terwujudnya game ini\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
